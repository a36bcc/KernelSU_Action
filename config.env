# ============================================================ 核心配置
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git
KERNEL_SOURCE_BRANCH=gold-s-oss
KERNEL_WORK_DIR=
KERNEL_CONFIG=gold_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

# ============================================================ 工具链
USE_LLVM=true
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

# ============================================================ KernelSU DDK
KSU_VARIANT=kernelsu
# 留空自动选择最新稳定版本（v0.9.5 或更高）
KSU_REF=

# ============================================================ 关闭所有 patch
ENABLE_SUSFS=false
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_CC_WERROR=true

# 清空 EXTRA_DEFCONFIG
EXTRA_DEFCONFIG=
