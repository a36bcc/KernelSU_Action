# ============================================================ Kernel source ==
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git
# ✅ 正确的分支名（就是你刚才提供的 gold-s-oss）
KERNEL_SOURCE_BRANCH=gold-s-oss

# ✅ 源码就在根目录，必须留空！
KERNEL_WORK_DIR=

# ✅ 确认为 gold_defconfig
KERNEL_CONFIG=gold_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

# 可选
KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# =================================================================== Clang ==
#CLANG_BRANCH=master-kernel-build-2022
#CLANG_VERSION=r450784e
#CLANG_BRANCH=main-kernel-2026
#CLANG_VERSION=r584948c
CLANG_BRANCH=master-kernel-build-2021
CLANG_VERSION=r416183b
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=true

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ==
KSU_VARIANT=kernelsu-next
KSU_REF=v3.3.0
KSU_HOOK_MODE=auto
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ==
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ==
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true
#EXTRA_DEFCONFIG=CONFIG_CRYPTO_ECDSA=n CONFIG_CRYPTO_ECDH=n
EXTRA_DEFCONFIG=
# ============================================================= AnyKernel3 ==
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ==
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ==
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=false
